{
  "opencollection": "1.0.0",
  "info": {
    "name": "Lingo.dev Engine Account API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the authenticated account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lingo.dev/users/me"
          },
          "docs": "Returns information about the account associated with the supplied API key. Backs the SDK whoami method and is used to validate credentials."
        }
      ]
    }
  ],
  "bundled": true
}