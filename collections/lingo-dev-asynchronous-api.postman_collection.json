          "id": "80d19ce3-fcbb-451b-9e34-364286524532",
          "name": "Create an asynchronous localization job group",
          "request": {
            "name": "Create an asynchronous localization job group",
            "description": {
              "content": "Submits content and a list of target locales. Creates a job group with one independent background job per locale and returns 202 with the group ID and per-locale job summaries. Results are delivered per locale via polling, webhook, or WebSocket as each job completes.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "jobs",
                "localization"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"key_0\": \"<string>\",\n    \"key_1\": \"<string>\"\n  },\n  \"targetLocales\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"sourceLocale\": \"<string>\",\n  \"webhookUrl\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
