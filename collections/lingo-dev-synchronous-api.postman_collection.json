          "name": "Localize key-value content",
          "request": {
            "name": "Localize key-value content",
            "description": {
              "content": "Translates a record of key-value strings from an optional source locale to a single target locale, preserving structure, glossary terms, and brand voice. Returns the translated data in the response. This is the endpoint that backs the SDK localizeText, localizeObject, localizeChat, localizeHtml, localizeStringArray, and batchLocalizeText methods.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "process",
                "localize"
              ],
