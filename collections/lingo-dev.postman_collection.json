            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceLocale\": \"en\",\n  \"targetLocales\": [\n    \"es\",\n    \"fr\",\n    \"de\"\n  ],\n  \"data\": {\n    \"greeting\": \"Hello, world!\"\n  }\n}",
